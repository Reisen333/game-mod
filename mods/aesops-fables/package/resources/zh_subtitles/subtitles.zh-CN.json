{"version":1,"language":"zh-CN","timeUnit":"seconds","media":{"data/sound/v1_1_a_done.ogg":[{"start":3.68,"end":7.54,"text":"陛下，这么晚冒昧打扰了。"}],"data/sound/v1_1_a_touch_1_done.ogg":[{"start":0,"end":1.58,"text":"那个……"}],"data/sound/v1_1_a_touch_2_done.ogg":[],"data/sound/v1_1_a_touch_3_done.ogg":[{"start":0,"end":0.72,"text":"那个……"}],"data/sound/v1_1_b_done.ogg":[{"start":0,"end":3.04,"text":"是的，自从新婚之夜以来。"}],"data/sound/v1_1_c_done.ogg":[{"start":2.0,"end":4.2,"text":"是的，已经不疼了。"}],"data/sound/v1_1_d_done.ogg":[{"start":0,"end":4.9,"text":"不，其实我只是想来见您一面。"},{"start":6.42,"end":12.02,"text":"听说陛下近来更加勤于政务。"},{"start":13.78,"end":21.9,"text":"百姓安居乐业，\n贤王的美名已越过城墙，传到了后宫。"},{"start":23.88,"end":28.48,"text":"不过，陛下，您有什么烦心事吗？"},{"start":29.5,"end":33.98,"text":"近来您也不曾问起我们的心事，"},{"start":34.62,"end":37.12,"text":"您的神情，似乎也有些心事重重。"},{"start":37.82,"end":39.84,"text":"若您方便说的话……"},{"start":40.76,"end":43.16,"text":"是不是身体不舒服呢……"},{"start":43.74,"end":45.36,"text":"大家都很担心您。"}],"data/sound/v1_2_done.ogg":[{"start":0.98,"end":5.94,"text":"陛下，侍女和护卫都已退下。"},{"start":8.94,"end":14.6,"text":"即使告诉我，也未必能解决您的烦恼，"},{"start":15.04,"end":22.1,"text":"但说出来，也许能理清思绪，让心情轻松一些。"},{"start":23.48,"end":30.12,"text":"能否让我多少分担一些陛下的忧愁呢？"}],"data/sound/v1_3_a_done.ogg":[],"data/sound/v1_3_b_done.ogg":[{"start":3.8,"end":4.4,"text":"陛下？"},{"start":5.46,"end":7.74,"text":"就算长着那样的耳朵，又有什么关系呢？"},{"start":8.76,"end":10.12,"text":"陛下依然是陛下。"},{"start":10.84,"end":15.14,"text":"即使长出了驴耳朵，您依然尽心为百姓着想，"},{"start":15.78,"end":19.0,"text":"也在担忧我们未来孩子的前途。"},{"start":19.74,"end":24.08,"text":"这样一位父亲的孩子，又有谁会不喜欢呢？"},{"start":27.02,"end":33.52,"text":"至少此刻，我希望能怀上陛下的孩子。"}],"data/sound/v1_4_1_done.ogg":[{"start":0,"end":2.42,"text":"啊，是。"}],"data/sound/v1_4_2_done.ogg":[{"start":0,"end":3.02,"text":"咦，啊，是。"}],"data/sound/v2_1_done.ogg":[{"start":2.96,"end":8.1,"text":"就保持这样，先让我用嘴侍奉您。"},{"start":10.52,"end":14.74,"text":"觉得舒服时，就试着发出声音吧。"},{"start":15.72,"end":18.58,"text":"用声音表达您的快感。"}],"data/sound/v2_2_1_1_1_done.ogg":[{"start":0,"end":3.26,"text":"那么，我先从前端开始舔。"}],"data/sound/v2_2_1_1_2_done.ogg":[{"start":2.8,"end":5.52,"text":"您不太喜欢用舌头吗？"},{"start":7.1,"end":10.04,"text":"那我试着整个含进嘴里。"}],"data/sound/v2_2_1_1_3_done.ogg":[{"start":0,"end":8.12,"text":"呵呵，接下来我会含住中间的部分。"}],"data/sound/v2_2_1_1_4_done.ogg":[{"start":4.76,"end":9.46,"text":"我的舌头能让您舒服，真是不胜荣幸。"},{"start":10.46,"end":13.82,"text":"接下来也请尽情享受我的嘴。"}],"data/sound/v2_2_1_1_5_done.ogg":[{"start":5.2,"end":10.64,"text":"声音太大的话，护卫会回来的哦。"}],"data/sound/v2_2_1_2_1_done.ogg":[],"data/sound/v2_2_1_2_2_done.ogg":[],"data/sound/v2_2_1_3_1_done.ogg":[{"start":4.28,"end":6.5,"text":"嗯？陛下？"},{"start":7.6,"end":11.9,"text":"既然陛下有这个打算，我也有自己的办法。"}],"data/sound/v2_2_1_3_2_done.ogg":[{"start":4.3,"end":5.46,"text":"您感觉如何？"},{"start":6.14,"end":12.18,"text":"看您的反应，比起用嘴，您似乎更喜欢我的舌头？"},{"start":12.92,"end":16.98,"text":"那么，我会多舔一会儿龟头。"}],"data/sound/v2_2_1_3_3_done.ogg":[{"start":4.56,"end":8.5,"text":"感觉陛下的茎身变得更粗了。"},{"start":9.24,"end":11.64,"text":"先继续提升茎身的快感，"},{"start":12.42,"end":17.4,"text":"然后再来品尝前端那颗红色的果实。"}],"data/sound/v2_2_1_3_4_done.ogg":[{"start":5.18,"end":10.06,"text":"看来陛下的龟头和茎身都很敏感呢。"},{"start":11.08,"end":16.0,"text":"接下来，我会仔细疼爱这两个地方。"}],"data/sound/v2_2_1_3_5_done.ogg":[{"start":3.14,"end":7.38,"text":"有那么舒服吗？我明白了。"},{"start":8.24,"end":11.98,"text":"稍微停一下，让它平静下来吧。"},{"start":16.74,"end":19.24,"text":"可以了吗？那么……"},{"start":19.92,"end":21.0,"text":"我要继续了。"}],"data/sound/v2_2_1_3_6_done.ogg":[{"start":5.74,"end":9.6,"text":"抱歉，我太投入了，没有注意到。"},{"start":11.1,"end":14.56,"text":"是，稍微等一等，等兴奋平息下来吧。"},{"start":19.94,"end":21.68,"text":"差不多可以了吗？"},{"start":23.02,"end":25.26,"text":"是，那我继续了。"}],"data/sound/v2_2_2_1_10_done.ogg":[],"data/sound/v2_2_2_1_11_done.ogg":[],"data/sound/v2_2_2_1_12_done.ogg":[],"data/sound/v2_2_2_1_1_done.ogg":[],"data/sound/v2_2_2_1_2_done.ogg":[],"data/sound/v2_2_2_1_3_done.ogg":[],"data/sound/v2_2_2_1_4_done.ogg":[],"data/sound/v2_2_2_1_5_done.ogg":[],"data/sound/v2_2_2_1_6_done.ogg":[],"data/sound/v2_2_2_1_7_done.ogg":[],"data/sound/v2_2_2_1_8_done.ogg":[],"data/sound/v2_2_2_1_9_done.ogg":[],"data/sound/v2_2_2_2_10_done.ogg":[],"data/sound/v2_2_2_2_1_done.ogg":[],"data/sound/v2_2_2_2_2_done.ogg":[],"data/sound/v2_2_2_2_3_done.ogg":[],"data/sound/v2_2_2_2_4_done.ogg":[],"data/sound/v2_2_2_2_5_done.ogg":[],"data/sound/v2_2_2_2_6_done.ogg":[],"data/sound/v2_2_2_2_7_done.ogg":[],"data/sound/v2_2_2_2_8_done.ogg":[],"data/sound/v2_2_2_2_9_done.ogg":[],"data/sound/v2_2_2_3_1_done.ogg":[{"start":3.4,"end":8.28,"text":"怎么样，差不多该到床上去了吧？"},{"start":15.76,"end":19.44,"text":"明白了，那我继续。"}],"data/sound/v2_2_2_3_2_done.ogg":[{"start":0,"end":6.88,"text":"呼……您对我的嘴还满意吗？"},{"start":8.02,"end":16.34,"text":"接下来，我想用下面的嘴……那个……侍奉您。"},{"start":21.58,"end":28.24,"text":"您似乎还想继续用这边的嘴……是，失礼了。"}],"data/sound/v2_2_2_3_3_done.ogg":[{"start":0,"end":8.92,"text":"呼……陛下，前戏就到这里，我们去床上吧？"},{"start":14.86,"end":18.88,"text":"明白了，您随时叫我就好。"}],"data/sound/v2_2_2_3_4_done.ogg":[{"start":0,"end":4.24,"text":"看来陛下这里已经等不及了。"},{"start":5.28,"end":9.42,"text":"陛下，可以进行下一步了吗？"},{"start":14.08,"end":17.96,"text":"陛下，请不要太勉强自己。"}],"data/sound/v2_2_2_3_5_done.ogg":[{"start":0,"end":4.42,"text":"太好了，您确实觉得舒服呢。"},{"start":7.14,"end":14.3,"text":"陛下，我们到床上做更舒服的事吧？"},{"start":17.64,"end":18.7,"text":"还要在这里继续吗？"},{"start":19.72,"end":22.62,"text":"明白了，那我继续。"}],"data/sound/v2_2_2_3_6_done.ogg":[{"start":0.92,"end":6.42,"text":"您能充分感受到快感，真是太好了。"},{"start":7.7,"end":14.84,"text":"陛下，为了让您更舒服，我们去床上吧？"},{"start":20.44,"end":22.12,"text":"还想让我用嘴吗？"},{"start":23.7,"end":26.9,"text":"是，那我再次失礼了。"}],"data/sound/v2_2_3_3_1_done.ogg":[{"start":0,"end":7.66,"text":"呼，陛下，我的嘴似乎已经到极限了。"},{"start":8.36,"end":9.52,"text":"您感觉如何？"},{"start":11.4,"end":15.4,"text":"接下来，能否请您到床上赐教呢？"},{"start":20.46,"end":21.42,"text":"我明白了。"},{"start":22.66,"end":24.54,"text":"不必着急呢。"}],"data/sound/v2_2_3_3_2_done.ogg":[{"start":2.2,"end":7.56,"text":"陛下，能听到您美妙的声音，我深感荣幸。"},{"start":8.82,"end":9.86,"text":"您感觉如何？"},{"start":10.88,"end":15.54,"text":"接下来，请到宽敞的床上赐教，好吗？"},{"start":21.8,"end":24.76,"text":"那么，我就继续用嘴侍奉您。"}],"data/sound/v2_2_3_3_3_done.ogg":[{"start":2.16,"end":6.54,"text":"陛下，谢谢您提前提醒我。"},{"start":8.54,"end":14.3,"text":"陛下珍贵的种子，我希望您能赐予合适的地方。"},{"start":16.98,"end":21.06,"text":"所以，陛下，请不要射在嘴里。"}],"data/sound/v2_2_3_3_4_done.ogg":[{"start":0,"end":6.52,"text":"呵呵，陛下，忍耐有害身体哦。"},{"start":7.08,"end":9.82,"text":"不必拘泥于形式。"},{"start":10.92,"end":13.18,"text":"请保持您原本的样子。"},{"start":16.68,"end":18.98,"text":"那么，请容我继续。"}],"data/sound/v2_2_4_1_1_done.ogg":[],"data/sound/v2_2_4_1_2_done.ogg":[],"data/sound/v2_2_4_1_3_done.ogg":[],"data/sound/v2_2_4_2_done.ogg":[],"data/sound/v2_2_4_3_1_1_done.ogg":[{"start":5.22,"end":6.82,"text":"真是抱歉。"},{"start":9.36,"end":13.14,"text":"请让我稍微喘口气。"},{"start":21.4,"end":22.86,"text":"让您久等了。"}],"data/sound/v2_2_4_3_1_2_done.ogg":[{"start":5.06,"end":11.64,"text":"陛下，您的那一根真是出色。"},{"start":19.52,"end":23.26,"text":"接下来，请让我继续品尝。"}],"data/sound/v2_2_4_3_1_3_done.ogg":[{"start":5.3,"end":9.4,"text":"请、请稍等一下。"},{"start":18.74,"end":20.2,"text":"让您久等了。"},{"start":21.26,"end":22.34,"text":"我要继续了。"}],"data/sound/v2_2_4_3_2_1_done.ogg":[{"start":0,"end":6.02,"text":"呼……接下来，我会重点舔前端。"},{"start":6.96,"end":8.9,"text":"如果刺激太强，请告诉我。"}],"data/sound/v2_2_4_3_2_2_done.ogg":[{"start":2.58,"end":5.82,"text":"您似乎很喜欢我的舌头呢。"},{"start":6.4,"end":10.22,"text":"请继续享受我的舌头。"}],"data/sound/v2_2_4_3_2_3_done.ogg":[{"start":0,"end":8.06,"text":"听说，红色舌头在那一根上游走的景象十分撩人。"},{"start":8.84,"end":12.94,"text":"请注意，不要太过兴奋了。"}],"data/sound/v2_2_4_3_3_1_done.ogg":[{"start":2.58,"end":5.74,"text":"接下来，我会多含住茎身一会儿。"},{"start":7.02,"end":10.78,"text":"如果刺激太强，请告诉我。"}],"data/sound/v2_2_4_3_3_2_done.ogg":[{"start":2.5,"end":5.4,"text":"听说男人都喜欢茎身被这样摩擦，"},{"start":6.46,"end":9.02,"text":"那我就再多为您磨一磨。"}],"data/sound/v2_2_4_3_3_3_done.ogg":[{"start":1.78,"end":11.16,"text":"接下来，我的嘴唇会继续向根部移动，\n快到极限时请提前告诉我。"}],"data/sound/v2_2_4_3_4_1_done.ogg":[{"start":0.74,"end":1.62,"text":"您还好吗？"},{"start":2.52,"end":6.54,"text":"果然还是差不多该到床上去了吧？"},{"start":7.4,"end":12.68,"text":"那我继续，快到极限时请再告诉我。"}],"data/sound/v2_2_4_3_4_2_done.ogg":[{"start":0.46,"end":2.5,"text":"您快要射了吗？"},{"start":3.78,"end":9.16,"text":"如果可以，\n我希望您射在能让我怀上孩子的地方……"},{"start":11.58,"end":16.44,"text":"陛下，射在嘴里是不会怀孕的哦。"}],"data/sound/v2_2_4_3_4_3_done.ogg":[{"start":0,"end":4.44,"text":"陛下，请不要在前戏时太勉强自己。"},{"start":5.76,"end":9.86,"text":"毕竟后面还有正事……"},{"start":10.8,"end":17.1,"text":"不过，听说陛下床上功夫了得，是我多虑了。"}],"data/sound/v2_2_4_3_4_4_done.ogg":[{"start":0.52,"end":9.66,"text":"不用忍得浑身发抖，这还只是前戏，\n请不要在上床之前就射出来……"},{"start":9.66,"end":10.96,"text":"还请您忍住哦。"}],"data/sound/v2_2_4_3_5_1_done.ogg":[{"start":2.56,"end":9.3,"text":"陛下，恕我多嘴，种子可不是要射在嘴里的。"},{"start":10.34,"end":15.78,"text":"所以，请别再这样捉弄我了。"}],"data/sound/v2_2_4_3_5_2_done.ogg":[{"start":2.08,"end":6.54,"text":"前戏差不多已经足够了吧？"},{"start":7.74,"end":13.24,"text":"不，我会一直陪到陛下满意为止。"}],"data/sound/v2_2_4_3_5_3_done.ogg":[{"start":0,"end":2.06,"text":"我们去床上吧？"},{"start":2.5,"end":8.08,"text":"陛下的那一根似乎已经足够兴奋了……"},{"start":10.88,"end":17.14,"text":"陛下，变得太大的话，之后会很难办的。"}],"data/sound/v2_2_4_3_5_4_done.ogg":[{"start":2.12,"end":11.38,"text":"陛下喜欢我的嘴，我当然很高兴，\n不过，其他地方也……"},{"start":11.38,"end":13.92,"text":"不想试试看吗？"},{"start":16.46,"end":19.46,"text":"好，那我继续。"}],"data/sound/v2_2_5_1_done.ogg":[],"data/sound/v2_2_5_2_done.ogg":[],"data/sound/v2_2_5_3_done.ogg":[],"data/sound/v2_2_6_1_done.ogg":[],"data/sound/v2_2_6_2_done.ogg":[],"data/sound/v2_2_6_3_done.ogg":[],"data/sound/v2_2_7_1_1_done.ogg":[],"data/sound/v2_2_7_1_1a_done.ogg":[],"data/sound/v2_2_7_1_1c_done.ogg":[],"data/sound/v2_2_7_1_2_done.ogg":[],"data/sound/v2_2_7_2_1_done.ogg":[],"data/sound/v2_2_7_2_1a_done.ogg":[],"data/sound/v2_2_7_2_1b_done.ogg":[],"data/sound/v2_2_7_2_1c_done.ogg":[],"data/sound/v2_2_7_2_2_done.ogg":[],"data/sound/v2_2_7_3_1_done.ogg":[],"data/sound/v2_2_7_3_2_done.ogg":[],"data/sound/v2_2_7_3_3_done.ogg":[],"data/sound/v2_2_7_3_4_done.ogg":[],"data/sound/v2_2_7_3_5_done.ogg":[],"data/sound/v2_2_8_1_done.ogg":[],"data/sound/v2_2_8_2_done.ogg":[],"data/sound/v2_2_9_1_done.ogg":[],"data/sound/v2_2_9_2_done.ogg":[],"data/sound/v2_2_9_3_done.ogg":[],"data/sound/v2_3_1_1_1_done.ogg":[{"start":0,"end":4.5,"text":"陛下，要先休息一下吗？"}],"data/sound/v2_3_1_2_1_done.ogg":[{"start":0,"end":4.5,"text":"陛下，要先休息一下吗？"}],"data/sound/v2_3_2_1_1_done.ogg":[{"start":0,"end":2.52,"text":"我明白了，那么……"}],"data/sound/v2_3_2_1_2_done.ogg":[{"start":0,"end":2.52,"text":"我明白了，那么……"}],"data/sound/v2_3_2_2_1_done.ogg":[{"start":0,"end":2.9,"text":"啊，明白了。"}],"data/sound/v2_3_2_2_2_done.ogg":[{"start":0,"end":2.9,"text":"啊，明白了。"}],"data/sound/v3_1_a_done.ogg":[{"start":0.96,"end":3.3,"text":"那我就在这里等您。"},{"start":4.32,"end":7.82,"text":"等您准备好了，请叫我。"}],"data/sound/v3_1_b_done.ogg":[{"start":0,"end":3.96,"text":"啊，那、那我就不客气了。"},{"start":6.36,"end":7.76,"text":"谢谢您。"}],"data/sound/v3_1_c_done.ogg":[{"start":1.94,"end":6.32,"text":"那个，这是我故意的，您不必在意。"}],"data/sound/v3_1_d_done.ogg":[{"start":0,"end":2.34,"text":"啊，是。"}],"data/sound/v3_1_e_done.ogg":[{"start":0,"end":4.54,"text":"啊，是，请吧。"}],"data/sound/v3_2_a_done.ogg":[{"start":5.5,"end":7.66,"text":"那个……"}],"data/sound/v3_2_a_se_done.ogg":[],"data/sound/v3_2_b_done.ogg":[{"start":0,"end":9.9,"text":"那个，陛下，\n您的耳朵……可以让我稍微摸一下吗？"}],"data/sound/v3_2_c_done.ogg":[{"start":0,"end":1.16,"text":"这样啊。"}],"data/sound/v3_2_d_1_done.ogg":[{"start":1.5,"end":2.08,"text":"谢谢您。"},{"start":5.24,"end":8.58,"text":"毛茸茸的，好暖和。"},{"start":9.26,"end":11.5,"text":"真的很像驴耳朵。"}],"data/sound/v3_2_d_2_done.ogg":[{"start":1.52,"end":2.12,"text":"谢谢您。"},{"start":5.02,"end":8.38,"text":"毛茸茸的，好暖和。"},{"start":9.06,"end":11.3,"text":"真的很像驴耳朵。"}],"data/sound/v3_2_d_loop1_done.ogg":[],"data/sound/v3_2_d_loop2_done.ogg":[],"data/sound/v3_2_e_done.ogg":[{"start":0,"end":2.8,"text":"啊，失礼了。"},{"start":3.98,"end":6.14,"text":"一不小心就怀念起来了。"},{"start":7.08,"end":10.5,"text":"仔细想想，这样会痒吧。"}],"data/sound/v3_2_f_done.ogg":[{"start":0,"end":0.7,"text":"是。"},{"start":4.12,"end":12.44,"text":"故乡的城堡里，有一头负责运货的驴，\n我从小就和它一起长大。"},{"start":15.5,"end":23.68,"text":"人们常说它们愚笨、难相处，\n其实它们只是在辨别人脸，选择……"},{"start":23.68,"end":25.44,"text":"值得信赖的对象罢了。"},{"start":27.9,"end":31.42,"text":"我是照顾它的人，它很亲近我，"},{"start":32.42,"end":36.46,"text":"离开故乡时，它也一直目送我到最后。"},{"start":37.66,"end":40.9,"text":"所以，我们的孩子也一定会……"},{"start":41.56,"end":45.04,"text":"拥有辨别值得信赖之人的聪慧，"},{"start":45.74,"end":48.8,"text":"以及关爱身边之人的温柔。"},{"start":49.6,"end":52.1,"text":"我是这样相信的。"}],"data/sound/v3_2_g_done.ogg":[{"start":0,"end":1.12,"text":"我明白了。"},{"start":1.92,"end":4.62,"text":"晚安，陛下。"}],"data/sound/v3_2_h_done.ogg":[{"start":12.98,"end":14.26,"text":"真是抱歉。"}],"data/sound/v3_2_j_done.ogg":[{"start":0,"end":2.5,"text":"咦？啊，是。"}],"data/sound/v4_1_1_1_done.ogg":[{"start":0,"end":3.2,"text":"那、那么，失礼了。"}],"data/sound/v4_1_1_2_done.ogg":[],"data/sound/v4_1_1_3_1_done.ogg":[],"data/sound/v4_1_1_3_1_se_done.ogg":[],"data/sound/v4_1_1_3_2_done.ogg":[],"data/sound/v4_1_1_3_2_se_done.ogg":[],"data/sound/v4_1_1_3_3_done.ogg":[{"start":1.08,"end":5.58,"text":"陛、陛下……差不多可以了吗……"},{"start":10.78,"end":11.82,"text":"陛下……"}],"data/sound/v4_1_1_4_1_done.ogg":[],"data/sound/v4_1_1_4_1_se_done.ogg":[],"data/sound/v4_1_1_4_2_done.ogg":[],"data/sound/v4_1_1_4_2_se_done.ogg":[],"data/sound/v4_1_2_1_done.ogg":[],"data/sound/v4_1_2_1_se_done.ogg":[],"data/sound/v4_1_2_1a_done.ogg":[],"data/sound/v4_1_2_2_done.ogg":[],"data/sound/v4_1_2_2_se_done.ogg":[],"data/sound/v4_1_2_2a_done.ogg":[],"data/sound/v4_1_2_2a_se_done.ogg":[],"data/sound/v4_2_1_1_done.ogg":[{"start":5.7,"end":9.04,"text":"没能全部容纳进去，真是抱歉。"},{"start":13.36,"end":15.5,"text":"不过，终于能在这里……"},{"start":16.08,"end":18.98,"text":"迎接陛下，我很高兴。"},{"start":21.06,"end":22.54,"text":"我要动了。"}],"data/sound/v4_2_1_1_se_done.ogg":[],"data/sound/v4_2_1_2_done.ogg":[],"data/sound/v4_2_1_3_done.ogg":[{"start":0,"end":10.9,"text":"啊，那、那个……太、太激烈了……等……"},{"start":11.38,"end":14.48,"text":"等、请等一下……"}],"data/sound/v4_2_1_3_se_done.ogg":[],"data/sound/v4_2_2_1_a_done.ogg":[],"data/sound/v4_2_2_1_a_se_done.ogg":[],"data/sound/v4_2_2_1_b_done.ogg":[],"data/sound/v4_2_2_1_b_se_done.ogg":[],"data/sound/v4_2_2_2_done.ogg":[],"data/sound/v4_2_2_2_se_done.ogg":[],"data/sound/v4_2_3_1_a_done.ogg":[{"start":11.52,"end":13.94,"text":"真是抱歉。"},{"start":13.94,"end":16.64,"text":"请让我稍微休息一下。"},{"start":16.64,"end":21.84,"text":"我马上就会继续。"}],"data/sound/v4_2_3_1_b_done.ogg":[{"start":10.7,"end":13.96,"text":"请稍等片刻。"}],"data/sound/v4_2_3_1_c_done.ogg":[{"start":11.18,"end":15.28,"text":"陛下，请您不要动。"},{"start":18.92,"end":21.38,"text":"由我来动就好。"}],"data/sound/v4_2_3_1_d_done.ogg":[{"start":10.66,"end":12.3,"text":"对不起。"},{"start":12.3,"end":14.64,"text":"我还不太习惯。"}],"data/sound/v4_2_3_2_a_done.ogg":[{"start":9.98,"end":11.6,"text":"谢谢您的体谅。"},{"start":14.14,"end":16.44,"text":"不过，请不用顾虑我，"},{"start":17.32,"end":18.98,"text":"尽情享受吧。"}],"data/sound/v4_2_3_2_b_done.ogg":[{"start":11.98,"end":16.42,"text":"请放心，我能坚持到最后。"},{"start":17.52,"end":22.4,"text":"别看这样，我也练习过的。"}],"data/sound/v4_2_3_2_c_done.ogg":[{"start":25.06,"end":26.02,"text":"您不会就这样结束吧？"}],"data/sound/v4_2_3_3_done.ogg":[{"start":0,"end":10.4,"text":"陛、陛下，如果您能就这样帮我动的话，我……"},{"start":10.4,"end":19.22,"text":"就轻松多了。是，那我继续。"}],"data/sound/v4_2_3_4_done.ogg":[{"start":6.3,"end":10.04,"text":"劳烦您了，真是抱歉。"},{"start":12.36,"end":16.08,"text":"我好像已经稍微习惯了，"},{"start":17.1,"end":18.94,"text":"接下来就由我来吧。"}],"data/sound/v5_1_done.ogg":[{"start":2.44,"end":10.44,"text":"陛下，陛下，陛下，您醒来感觉如何？"},{"start":12.58,"end":21.42,"text":"是的，您睡得很香，\n所以我又在这里欣赏了陛下的睡颜……"},{"start":21.42,"end":22.24,"text":"好好看了个够。"},{"start":25.0,"end":30.04,"text":"而且今晚，您似乎还说了些梦话。"},{"start":30.88,"end":37.36,"text":"把我独自留在现实中，您在梦里究竟做了些什么？"},{"start":41.82,"end":45.36,"text":"和梦中的我生育继承人？"},{"start":48.16,"end":52.06,"text":"那真是不胜荣幸。"},{"start":53.8,"end":59.9,"text":"我对初夜的印象，也非常深刻。"},{"start":60.62,"end":67.06,"text":"毕竟，那是您赐予我这个孩子的特别之夜。"}],"data/sound/v5_2_1_1_1_done.ogg":[{"start":0.56,"end":7.44,"text":"不过，那一晚的经过，实在谈不上值得称赞。"},{"start":8.24,"end":13.46,"text":"我才刚开始动，陛下您就射了。"},{"start":15.66,"end":23.66,"text":"当时我因为初次的疼痛和紧张，\n根本无暇享受交欢，"},{"start":23.72,"end":28.4,"text":"所以您能早点射出来，老实说我还很感激。"}],"data/sound/v5_2_1_1_2_done.ogg":[{"start":1.54,"end":8.26,"text":"不过，生育继承人的职责，\n比初经人事的我原先想象的……"},{"start":8.26,"end":9.44,"text":"要辛苦得多。"},{"start":11.18,"end":17.1,"text":"您似乎等不及我笨拙的动作，\n才刚用双臂环住我的腰……"},{"start":17.1,"end":19.14,"text":"紧紧抱住我之后，"},{"start":19.14,"end":24.36,"text":"就从下面有力地，一次又一次地向上顶。"},{"start":25.48,"end":28.64,"text":"不过，不知道是不是那些刺激的缘故，"},{"start":29.34,"end":33.72,"text":"不知不觉间，我也开始感到舒服了。"}],"data/sound/v5_2_1_2_1_done.ogg":[{"start":0,"end":4.92,"text":"另外让我遗憾的，是您射精之后的事。"},{"start":6.42,"end":15.12,"text":"因为精液，里面变得更加润滑，\n正要进入佳境时，陛下却……"},{"start":15.12,"end":15.96,"text":"当场叫了停。"}],"data/sound/v5_2_1_2_2_done.ogg":[{"start":0,"end":7.74,"text":"用嘴侍奉时，您也已经射过，\n我想着，再请您继续……"},{"start":7.74,"end":14.44,"text":"也许太为难您，所以那时就乖乖退让了。"},{"start":14.96,"end":20.14,"text":"真想给当时的自己提一句忠告。"}],"data/sound/v5_2_1_2_3_done.ogg":[{"start":0,"end":8.28,"text":"那可是您当晚第一次射精，\n虽说目的是得到种子，还是太可惜……"},{"start":8.28,"end":9.12,"text":"太可惜了。"},{"start":10.94,"end":15.26,"text":"本来还可以让您更加舒服的。"}],"data/sound/v5_2_2_1_1_done.ogg":[{"start":0,"end":4.24,"text":"当然，那一夜还有其他特别之处。"},{"start":5.32,"end":14.26,"text":"第一次接受陛下时，那个，\n我稍微哭了，但您渐渐让我感到舒服……"},{"start":14.26,"end":19.7,"text":"明明还是初次，却连高潮都体验到了。"}],"data/sound/v5_2_2_1_2_done.ogg":[{"start":0,"end":3.0,"text":"而且还是在陛下射精之前。"},{"start":3.66,"end":8.62,"text":"无论过去还是现在，陛下都很懂得男人的职责。"},{"start":9.42,"end":13.06,"text":"能嫁到陛下身边，"},{"start":13.66,"end":17.22,"text":"我觉得自己非常幸运。"}],"data/sound/v5_2_2_1_3_done.ogg":[{"start":0,"end":6.9,"text":"也许也多亏陛下射精之后，里面变得更加润滑，"},{"start":7.72,"end":12.18,"text":"但您回应我的渴求时，那份激动的感觉……"},{"start":13.02,"end":18.4,"text":"如今回想起来，身体深处依然会发热。"}],"data/sound/v5_2_2_2_1_done.ogg":[{"start":0,"end":6.22,"text":"只是您只射了一次，还是让我有些遗憾。"},{"start":7.0,"end":12.78,"text":"我们各自高潮一次，明明才刚进入佳境。"}],"data/sound/v5_2_2_2_2_done.ogg":[{"start":0,"end":8.44,"text":"是，算上前戏，陛下的确射了两次，\n但这样算的话，我……"},{"start":8.44,"end":12.42,"text":"只高潮了一次，岂不是有点不公平？"},{"start":13.4,"end":18.72,"text":"换成现在的我，至少会请您再陪我三次。"}],"data/sound/v5_2_2_2_3_done.ogg":[{"start":0,"end":6.74,"text":"不过相应地，您一次就注入了许多种子。"},{"start":7.46,"end":12.34,"text":"用嘴侍奉时，您也好好忍住了，"},{"start":12.8,"end":18.28,"text":"生育继承人还要追求次数，也许是我太贪心了。"},{"start":19.64,"end":23.58,"text":"当然，现在可就另当别论了。"}],"data/sound/v5_2_3_1_done.ogg":[{"start":0,"end":6.98,"text":"唉……光是回想，就忍不住叹息。"},{"start":7.68,"end":17.86,"text":"初次的疼痛过后，交欢的喜悦，\n以及陛下不断回应我任性索求的可靠……"}],"data/sound/v5_2_3_2_1_done.ogg":[{"start":0,"end":5.66,"text":"无论我叫了多少次，\n陛下的那一根都迟迟没有射精，"},{"start":5.66,"end":8.24,"text":"我简直都要受不了了。"},{"start":9.74,"end":13.44,"text":"一切都被舒服的感觉支配着，"},{"start":14.08,"end":16.88,"text":"连我自己说过些什么，都不记得了。"},{"start":17.54,"end":22.32,"text":"把那么不知羞耻的模样展现给别人，"},{"start":22.32,"end":24.84,"text":"那一夜应该还是第一次。"},{"start":26.64,"end":27.74,"text":"是真的哦。"}],"data/sound/v5_2_3_2_2_done.ogg":[{"start":1.52,"end":8.28,"text":"还有陛下那一次都不够的旺盛精力。\n您知道吗，陛下？"},{"start":9.12,"end":13.96,"text":"听说一般男人很难连续射精。"},{"start":14.98,"end":22.16,"text":"陛下拥有众多妃子，这也算是王者的资质之一吧？"},{"start":24.06,"end":32.1,"text":"直到亲眼见证……不，\n亲身体验之前，我也想象不到。"},{"start":32.7,"end":37.06,"text":"说实话，因为陛下让我舒服了好多次，"},{"start":37.56,"end":39.24,"text":"当时的事，我已经不太记得了……"}],"data/sound/v5_2_3_2_3_done.ogg":[{"start":1.28,"end":7.16,"text":"还有连宙斯都会自愧不如的精力，\n您总是让我吃惊。"},{"start":8.64,"end":17.9,"text":"听医者说，射精太多会射出血来，然而陛下的……"},{"start":17.9,"end":19.34,"text":"总是纯白的呢。"},{"start":20.42,"end":24.68,"text":"最后用嘴侍奉时，量也依然很多。"},{"start":26.84,"end":31.56,"text":"难道是驴耳朵带来的效果吗？"},{"start":32.38,"end":36.76,"text":"如果真是这样，诅咒也不全是坏事。"},{"start":37.48,"end":46.92,"text":"倒不如说，为了让诅咒长久持续，\n得多向太阳神的神殿进献贡品才行。"},{"start":48.9,"end":51.3,"text":"每次陛下射在我里面，"},{"start":51.78,"end":55.14,"text":"您想与我生下孩子的那份爱，"},{"start":55.92,"end":59.86,"text":"就仿佛在我体内扩散开来。"}],"data/sound/v5_3_1_done.ogg":[{"start":0.82,"end":7.7,"text":"话说陛下，比起以前的我，\n您更喜欢现在的我，对吧？"},{"start":11.7,"end":13.72,"text":"您还在犹豫什么？"},{"start":17.74,"end":23.54,"text":"那么今晚，我会让您好好想起现在的我的魅力。"},{"start":25.52,"end":28.32,"text":"请做好准备，陛下。"}],"data/sound/v5_3_2_done.ogg":[{"start":3.78,"end":6.22,"text":"瞧您那一脸陶醉的表情，"},{"start":7.16,"end":12.3,"text":"独自和梦中的我享乐，陛下真狡猾。"},{"start":13.36,"end":15.82,"text":"怎么样，陛下？"},{"start":16.38,"end":22.08,"text":"接下来，和现实中的我尽情延续梦境如何？"},{"start":24.96,"end":29.28,"text":"今晚也不会让您睡的，我的陛下。"}],"data/sound/v6_1_done.ogg":[{"start":0,"end":1.34,"text":"早上好。"},{"start":1.34,"end":2.64,"text":"陛下。"},{"start":3.48,"end":5.08,"text":"您有什么吩咐吗？"}],"data/sound/v6_2_done.ogg":[{"start":0,"end":10.22,"text":"是的，后宫里其他妃子姐姐们告诉我，\n陛下喜欢骑乘位，所以……"},{"start":10.22,"end":11.16,"text":"我就照着做了。"},{"start":13.36,"end":15.0,"text":"听说，"},{"start":15.82,"end":18.4,"text":"以前您也曾闭门不出过。"},{"start":19.32,"end":20.84,"text":"那时，陛下从神明那里，"},{"start":21.44,"end":25.44,"text":"得到了让触碰之物全变成黄金的奇迹。"},{"start":26.24,"end":29.74,"text":"您一边抱怨，连水都不能好好喝，"},{"start":30.4,"end":31.6,"text":"却从衣服、鞋子，"},{"start":32.54,"end":35.02,"text":"以及地面都没有变成黄金这件事，"},{"start":35.96,"end":38.7,"text":"发现奇迹只影响了脸和双手。"},{"start":38.7,"end":47.86,"text":"也就是说，依然能生孩子，于是让妃子在上面，\n努力完成生育继承人的职责。"},{"start":47.86,"end":56.42,"text":"听说从那之后，陛下就喜欢上了骑乘位。"},{"start":58.72,"end":65.34,"text":"而且，无论陛下受到什么诅咒，总还能生孩子，"},{"start":65.92,"end":68.74,"text":"姐姐们都异口同声地这样说，"},{"start":69.24,"end":71.98,"text":"这也让我鼓起了勇气。"},{"start":74.22,"end":79.24,"text":"不过，这次只是耳朵变成了驴耳朵，"},{"start":79.82,"end":83.56,"text":"又听说后背位最适合生孩子，"},{"start":83.56,"end":89.38,"text":"所以，仔细想想，也没必要执着于骑乘位呢。"}],"data/sound/v6_3_done.ogg":[{"start":0,"end":1.76,"text":"我并不担心。"},{"start":2.4,"end":4.4,"text":"这次也是如此，"},{"start":4.4,"end":6.04,"text":"听说陛下过去，"},{"start":6.04,"end":8.78,"text":"也遭遇过许多考验。"},{"start":9.62,"end":10.06,"text":"而且，"},{"start":11.16,"end":13.76,"text":"每一次都改正自己的行为，"},{"start":14.48,"end":17.02,"text":"最终战胜了困难。"},{"start":17.62,"end":18.3,"text":"所以，"},{"start":18.94,"end":21.86,"text":"我相信，这次也一定能找到出路。"},{"start":22.82,"end":24.34,"text":"为了这个国家，"},{"start":25.02,"end":27.04,"text":"也为了我们的孩子。"}],"data/sound/v6_4_done.ogg":[{"start":1.06,"end":2.16,"text":"是，陛下。"},{"start":3.24,"end":5.92,"text":"那么，祝您安好。"}],"data/sound/v6_5_done.ogg":[{"start":0,"end":2.2,"text":"本作品纯属虚构。"},{"start":2.94,"end":7.56,"text":"与现实中的人物和团体均无关联。"},{"start":8.78,"end":15.92,"text":"不过，与“色情”一词词源有关的爱神，\n以及“恐慌”一词词源中的牧神，"},{"start":16.64,"end":25.56,"text":"还有以载人登月计划之名闻名的太阳神，\n大概还是有关系的。"},{"start":26.88,"end":27.56,"text":"以上。"}],"data/video/4_10_0_1.webm":[{"start":1.62,"end":2.58,"text":"陛下？"}],"data/video/4_10_0_2.webm":[],"data/video/4_10_1_1.webm":[],"data/video/4_10_1_2.webm":[],"data/video/4_10_2_1.webm":[],"data/video/4_10_2_2.webm":[],"data/video/4_10_3_1.webm":[],"data/video/4_10_3_2.webm":[{"start":6.56,"end":9.7,"text":"再稍微保持这样一会儿。"}],"data/video/4_2_1_1.webm":[{"start":5.68,"end":9.04,"text":"没能全部容纳进去，真是抱歉。"},{"start":13.32,"end":15.52,"text":"不过，终于能在这里……"},{"start":16.08,"end":18.98,"text":"迎接陛下，我很高兴。"},{"start":21.02,"end":22.54,"text":"我要动了。"}],"data/video/4_2_1_2.webm":[],"data/video/4_2_1_3.webm":[{"start":4.0,"end":5.5,"text":"那、那个……"},{"start":5.5,"end":9.42,"text":"啊，太激烈了……太激烈了……"},{"start":10.16,"end":13.48,"text":"等、请等一下……"}],"data/video/4_2_2_1_a.webm":[],"data/video/4_2_2_1_b.webm":[],"data/video/4_2_2_2.webm":[],"data/video/4_2_3_1_a.webm":[{"start":11.52,"end":13.94,"text":"真是抱歉。"},{"start":13.94,"end":16.64,"text":"请让我稍微休息一下。"},{"start":16.64,"end":21.86,"text":"我马上就会继续。"}],"data/video/4_2_3_1_b.webm":[{"start":10.52,"end":13.96,"text":"请稍等片刻。"}],"data/video/4_2_3_1_c.webm":[{"start":11.18,"end":15.28,"text":"陛下，请您不要动。"},{"start":18.92,"end":21.4,"text":"由我来动就好。"}],"data/video/4_2_3_1_d.webm":[{"start":10.66,"end":12.3,"text":"对不起。"},{"start":12.3,"end":14.64,"text":"我还不太习惯。"}],"data/video/4_2_3_1_e.webm":[],"data/video/4_2_3_2_a.webm":[{"start":9.98,"end":11.6,"text":"谢谢您的体谅。"},{"start":14.14,"end":16.38,"text":"不过，请不用顾虑我，"},{"start":17.32,"end":18.98,"text":"尽情享受吧。"}],"data/video/4_2_3_2_b.webm":[{"start":11.98,"end":16.42,"text":"请放心，我能坚持到最后。"},{"start":17.52,"end":22.4,"text":"别看这样，我也练习过的。"}],"data/video/4_2_3_2_c.webm":[],"data/video/4_2_3_2_d.webm":[{"start":9.68,"end":10.36,"text":"那个……"},{"start":11.5,"end":12.52,"text":"陛下。"},{"start":13.58,"end":15.98,"text":"我没关系，"},{"start":15.98,"end":18.38,"text":"您想什么时候，"},{"start":18.82,"end":20.2,"text":"射出来都可以。"}],"data/video/4_2_3_2_e.webm":[{"start":0,"end":9.14,"text":"陛下，什么时候才能赐予我种子呢？"},{"start":9.74,"end":14.82,"text":"可以的话，那个，请尽量快一点。"}],"data/video/4_2_3_3.webm":[{"start":0,"end":10.4,"text":"啊，陛下，如果您能就这样帮我动的话，我……"},{"start":10.4,"end":19.24,"text":"就轻松多了。是，那我继续。"}],"data/video/4_2_3_3_b.webm":[{"start":9.3,"end":13.92,"text":"陛下的那一根，在我里面变大了。"},{"start":14.86,"end":17.66,"text":"为了让您更加舒服，"},{"start":17.66,"end":19.16,"text":"我会努力的。"}],"data/video/4_2_3_3_c.webm":[{"start":8.84,"end":9.84,"text":"陛下。"},{"start":9.84,"end":12.32,"text":"难道说，"},{"start":12.32,"end":15.14,"text":"您正在忍着不射吗？"},{"start":16.24,"end":17.32,"text":"不……"},{"start":17.32,"end":19.34,"text":"我要继续了。"}],"data/video/4_2_3_3_d.webm":[{"start":10.68,"end":12.24,"text":"果然很难……"},{"start":12.24,"end":13.94,"text":"顺利地进出呢。"},{"start":14.9,"end":16.3,"text":"为了让陛下，"},{"start":16.3,"end":17.74,"text":"能够更加尽兴，"},{"start":17.74,"end":19.0,"text":"我会努力的。"}],"data/video/4_2_3_4.webm":[{"start":6.3,"end":10.04,"text":"劳烦您了，真是抱歉。"},{"start":12.36,"end":16.08,"text":"我好像已经稍微习惯了，"},{"start":17.1,"end":18.94,"text":"接下来就由我来吧。"}],"data/video/4_3_1_1_1_a.webm":[{"start":0,"end":8.12,"text":"啊……太、太激烈了……"}],"data/video/4_3_1_1_2_a.webm":[],"data/video/4_3_2_1_1.webm":[],"data/video/4_3_2_1_2.webm":[],"data/video/4_3_2_1_3.webm":[],"data/video/4_3_2_5_1_a.webm":[],"data/video/4_3_3_1_a_A.webm":[{"start":2.68,"end":9.94,"text":"虽说听人提过，但想怀上孩子，也需要体力呢。"}],"data/video/4_3_3_1_b_A.webm":[{"start":2.5,"end":3.92,"text":"对不起。"},{"start":4.68,"end":7.3,"text":"我有些喘不过气……"},{"start":11.42,"end":14.46,"text":"让您久等了。"}],"data/video/4_3_3_1_c_A.webm":[{"start":1.66,"end":9.44,"text":"陛下，如果您能早点射，我会很感激的。"}],"data/video/4_3_3_1_d_A.webm":[{"start":14.54,"end":19.3,"text":"不，我还没到极限，"},{"start":22.54,"end":24.22,"text":"我要继续了。"}],"data/video/4_3_3_1_e_A.webm":[{"start":3.68,"end":4.6,"text":"没关系。"},{"start":7.16,"end":8.08,"text":"我会……"},{"start":10.44,"end":13.54,"text":"好好让您舒服的。"}],"data/video/4_3_3_2_a.webm":[{"start":1.6,"end":7.0,"text":"长耳朵都向后倒了，看起来很难受。"},{"start":8.5,"end":13.18,"text":"是，放松时，耳朵应该是垂向两边的。"},{"start":14.96,"end":18.42,"text":"对，就是这样，让呼吸平静下来。"},{"start":20.92,"end":21.36,"text":"那么……"}],"data/video/4_3_3_2_b.webm":[{"start":0,"end":4.54,"text":"啊，是，我们先平静一下吧。"},{"start":5.78,"end":13.86,"text":"呼……那么……"}],"data/video/4_3_3_2_c.webm":[{"start":0,"end":3.52,"text":"咦，啊，差不多可以了吗？"},{"start":5.46,"end":6.46,"text":"我明白了。"},{"start":7.44,"end":11.0,"text":"不过，请不要太勉强自己。"},{"start":11.42,"end":15.62,"text":"我，那个，随时都可以。"}],"data/video/4_3_3_2_d.webm":[{"start":0,"end":10.34,"text":"啊，那个，不，请别担心，\n我一直期待着这一刻，这点……"},{"start":10.34,"end":11.86,"text":"根本不算什么。"},{"start":12.96,"end":16.0,"text":"不过，差不多可以了吗？"}],"data/video/4_3_3_2_e.webm":[{"start":3.6,"end":8.04,"text":"陛下，您的表情似乎很难受。"},{"start":9.06,"end":13.1,"text":"我的小腹深处，也有些难耐。"},{"start":14.34,"end":18.38,"text":"所以，陛下……"}],"data/video/4_3_3_3_a_A.webm":[{"start":0,"end":2.44,"text":"陛下……"},{"start":3.36,"end":6.72,"text":"可以请您再忍耐一会儿吗？"},{"start":7.52,"end":14.72,"text":"那个……中途停下来，总觉得……有些难受……"},{"start":14.72,"end":21.56,"text":"啊……抱歉……我这是怎么了……"},{"start":21.56,"end":23.98,"text":"那我继续了。"}],"data/video/4_3_3_3_b_A.webm":[{"start":4.36,"end":8.0,"text":"总觉得小腹深处一阵酥麻。"},{"start":8.94,"end":11.34,"text":"不，我没事。"},{"start":11.96,"end":14.42,"text":"几乎已经不疼了，"},{"start":14.42,"end":16.94,"text":"请让我继续到最后。"}],"data/video/4_3_3_3_c_A.webm":[{"start":2.12,"end":5.02,"text":"是因为来来回回进出了好多次吗？"},{"start":5.58,"end":10.52,"text":"里面一阵阵发麻，好像有什么要涌出来了。"}],"data/video/4_3_3_3_d_A.webm":[{"start":4.36,"end":10.98,"text":"初次的疼痛消失了，反而停下来才让我难耐……"},{"start":11.94,"end":15.74,"text":"这也是多亏陛下的帮助吗……"}],"data/video/4_3_3_3_e_A.webm":[{"start":3.16,"end":6.82,"text":"陛下，您尽兴了吗？"},{"start":6.82,"end":7.84,"text":"是。"},{"start":8.78,"end":15.12,"text":"我的身体也热得迷迷糊糊的。"},{"start":16.32,"end":19.8,"text":"简直像做梦一样。"}],"data/video/4_3_3_4_a.webm":[],"data/video/4_3_3_4_b.webm":[{"start":6.0,"end":8.1,"text":"也许是我的错觉，"},{"start":9.02,"end":11.42,"text":"您从下面顶上来的时候，"},{"start":12.34,"end":15.0,"text":"感觉里面也慢慢舒展开了。"},{"start":16.32,"end":19.84,"text":"陛下，可以再拜托您一次吗？"}],"data/video/4_3_3_4_c.webm":[{"start":4.96,"end":10.74,"text":"原来生孩子，是这样激烈地渴求彼此啊。"},{"start":11.96,"end":16.08,"text":"总觉得，有点要上瘾了。"}],"data/video/4_3_3_4_d.webm":[{"start":5.28,"end":8.16,"text":"又要劳烦您了。"},{"start":9.04,"end":13.26,"text":"不，那个，我不是不喜欢，"},{"start":14.0,"end":17.82,"text":"倒不如说，我觉得很舒服。"}],"data/video/4_3_3_4_e.webm":[{"start":5.18,"end":9.82,"text":"陛下的腰上功夫，果然了得。"},{"start":10.8,"end":14.76,"text":"我也会更加努力。"}],"data/video/4_4_1_1_3_a.webm":[],"data/video/4_4_1_1_3_b.webm":[],"data/video/4_4_1_1_3_c.webm":[{"start":0,"end":0.46,"text":"来吧……"}],"data/video/4_4_1_1_4_a.webm":[],"data/video/4_4_1_1_4_b.webm":[],"data/video/4_4_1_1_4_c.webm":[{"start":0,"end":0.46,"text":"来吧……"}],"data/video/4_4_2_2_1.webm":[],"data/video/4_4_2_2_2.webm":[],"data/video/4_4_2_5_1.webm":[],"data/video/4_4_2_5_2.webm":[],"data/video/4_4_2_6_2.webm":[],"data/video/4_4_2_6_3.webm":[],"data/video/4_4_3_1_a.webm":[{"start":2.7,"end":7.0,"text":"这就是……这样的……"},{"start":12.64,"end":17.5,"text":"陛下……再多……再多做一些吧？"}],"data/video/4_4_3_1_b.webm":[{"start":2.72,"end":9.82,"text":"生孩子竟然能这么舒服……"},{"start":10.74,"end":12.62,"text":"我已经受不了了。"}],"data/video/4_4_3_1_c.webm":[{"start":0,"end":11.04,"text":"抱歉，陛下……又是我一个人先……可是……"},{"start":11.04,"end":13.8,"text":"还不够……"}],"data/video/4_4_3_1_d.webm":[{"start":2.6,"end":4.84,"text":"明明刚刚才高潮，"},{"start":7.94,"end":9.36,"text":"里面又开始发痒，"},{"start":11.5,"end":14.7,"text":"我又变得难耐了。"}],"data/video/4_4_3_1_e.webm":[{"start":2.08,"end":5.88,"text":"陛下，我爱您。"},{"start":5.88,"end":13.48,"text":"所以，请让我再多高潮几次。"}],"data/video/4_4_3_1_f.webm":[{"start":3.72,"end":11.68,"text":"好厉害，陛下……再多……再多给我一些……"}],"data/video/4_4_3_1_g.webm":[{"start":5.82,"end":11.14,"text":"本来应该由我来让您舒服的，"},{"start":12.08,"end":14.84,"text":"陛下，我最喜欢您了。"}],"data/video/4_4_3_1_h.webm":[{"start":2.9,"end":14.28,"text":"我居然会骑在男人身上，\n不知羞耻地一次次高潮……这件事……"},{"start":14.28,"end":18.12,"text":"请不要告诉别人。"}],"data/video/4_4_3_2_a_A.webm":[{"start":12.72,"end":23.24,"text":"啊，陛下，您一直努力忍着不射。\n来，让呼吸平静下来，对……"},{"start":23.26,"end":24.88,"text":"就是这样。"},{"start":25.82,"end":31.4,"text":"这样好好休息一会儿，又能慢慢享受了。"}],"data/video/4_4_3_2_a_S.webm":[{"start":12.72,"end":23.24,"text":"啊，陛下，您一直努力忍着不射。\n来，让呼吸平静下来，对……"},{"start":23.26,"end":24.88,"text":"就是这样。"},{"start":25.82,"end":31.4,"text":"这样好好休息一会儿，又能慢慢享受了。"}],"data/video/4_4_3_2_b_A.webm":[{"start":2.46,"end":12.76,"text":"爸爸妈妈原来也做过这么舒服的事，\n我以前完全不知道。"},{"start":15.52,"end":20.74,"text":"难怪我有那么多兄弟姐妹。"}],"data/video/4_4_3_2_b_S.webm":[{"start":2.46,"end":12.76,"text":"爸爸妈妈原来也做过这么舒服的事，\n我以前完全不知道。"},{"start":15.52,"end":20.74,"text":"难怪我有那么多兄弟姐妹。"}],"data/video/4_4_3_2_c_A.webm":[{"start":14.04,"end":18.26,"text":"陛下的那一根，是迫不及待想让我怀孕，"},{"start":18.84,"end":20.64,"text":"所以才这样蠢蠢欲动吧。"},{"start":22.86,"end":25.08,"text":"不过，陛下您自己怎么想呢？"},{"start":26.3,"end":27.98,"text":"是现在就射出来，"},{"start":27.98,"end":34.48,"text":"还是先忍住，再和我一起享受快感呢？"}],"data/video/4_4_3_2_c_S.webm":[{"start":14.04,"end":18.26,"text":"陛下的那一根，是迫不及待想让我怀孕，"},{"start":18.84,"end":20.64,"text":"所以才这样蠢蠢欲动吧。"},{"start":22.86,"end":25.08,"text":"不过，陛下您自己怎么想呢？"},{"start":26.3,"end":27.98,"text":"是现在就射出来，"},{"start":27.98,"end":34.48,"text":"还是先忍住，再和我一起享受快感呢？"}],"data/video/4_4_3_2_d_A.webm":[{"start":14.12,"end":18.08,"text":"您还想这样继续下去，对吧？"},{"start":19.58,"end":20.86,"text":"我也是。"},{"start":21.72,"end":23.06,"text":"您知道吗？"},{"start":24.1,"end":26.24,"text":"听说女人越是高潮，"},{"start":26.8,"end":29.14,"text":"就越容易怀上孩子。"},{"start":29.14,"end":34.18,"text":"所以，陛下……"}],"data/video/4_4_3_2_d_S.webm":[{"start":14.12,"end":18.08,"text":"您还想这样继续下去，对吧？"},{"start":19.58,"end":20.86,"text":"我也是。"},{"start":21.72,"end":23.06,"text":"您知道吗？"},